{
  "name": "retrospected",
  "version": "6.0.0",
  "description": "An agile retrospective board - Powering www.retrospected.com",
  "private": true,
  "scripts": {
    "lint": "biome ci",
    "clean": "del ./{frontend,backend,common,maintenance}/package-lock.json && del ./package-lock.json && del ./{frontend,backend,common,maintenance}/node_modules && del ./node_modules",
    "frontend": "cd frontend && npm start && cd ..",
    "backend": "cd backend && cargo run -p retrospected-server",
    "stripe-login": "stripe login",
    "stripe-listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook",
    "bump": ". ./scripts/bump.sh",
    "mig": "cd backend && cargo run -p retrospected-migrations --bin retrospected-migrate",
    "new-migration": "cd backend && cargo run -q -p retrospected-migrations --bin retrospected-new-migration --",
    "hardcode-licence": "cd backend && cargo run -q -p retrospected-server --bin retrospected-hardcode-licence --"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antoinejaussoin/retro-board.git"
  },
  "keywords": [
    "agile",
    "retrospective",
    "board",
    "react hooks",
    "react",
    "universal",
    "socket.io",
    "styled-components",
    "SPA",
    "single page application",
    "typescript",
    "docker",
    "docker-compose",
    "postgres",
    "anthropic",
    "claude"
  ],
  "author": "Antoine Jaussoin",
  "license": "GNU GPLv3",
  "bugs": {
    "url": "https://github.com/antoinejaussoin/retro-board/issues"
  },
  "homepage": "https://www.retrospected.com",
  "dependencies": {
    "del-cli": "6.0.0",
    "@biomejs/biome": "1.9.4"
  }
}
