{
  // Editor and `tsc` config. Inlined from @tsconfig/docusaurus without `baseUrl`,
  // which TypeScript 7 removed.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react",
    "lib": ["dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": [
      "node",
      "@docusaurus/module-type-aliases",
      "@docusaurus/theme-classic"
    ],
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  }
}
