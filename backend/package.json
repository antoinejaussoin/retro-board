{
  "name": "@retrospected/backend",
  "version": "5.5.3",
  "license": "GNU GPLv3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc --build && yarn copy-templates && cp ./instrument.mjs ./dist/instrument.mjs",
    "start": "nodemon --exec 'yarn fix & node' --import ./ts-node.register.mjs ./src/index.ts",
    "create-migration": "scripty",
    "create-empty-migration": "scripty",
    "hardcode-licence": "scripty",
    "migrate": "typeorm-ts-node-esm -d src/db/index.ts migration:run",
    "revert": "typeorm-ts-node-esm -d src/db/index.ts migration:revert",
    "lint": "biome lint",
    "test": "yarn jest",
    "ci-lint": "biome ci",
    "ci-test": "CI=true yarn test",
    "fix": "biome check --write",
    "backend-production": "yarn migrate-production && cd ./dist/src && node --import ../instrument.mjs index.js",
    "migrate-production": "typeorm -d dist/src/db/index.js migration:run",
    "copy-templates": "copyfiles -u 0 src/**/*.html dist/"
  },
  "dependencies": {
    "@biomejs/biome": "1.9.4",
    "@sendgrid/mail": "8.1.6",
    "@sentry/node": "8.55.2",
    "@socket.io/redis-adapter": "8.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-redis": "0.0.20",
    "@types/cookie-parser": "1.4.10",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "4.17.25",
    "@types/express-mung": "0.5.5",
    "@types/express-session": "1.17.4",
    "@types/jest": "29.5.14",
    "@types/lodash": "4.17.27",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "26.6.6",
    "@types/node-fetch": "2.6.13",
    "@types/nodemailer": "6.4.21",
    "@types/passport": "1.0.11",
    "@types/passport-github2": "1.2.9",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/passport-local": "1.0.34",
    "@types/passport-microsoft": "1.0.0",
    "@types/passport-twitter": "1.0.40",
    "@types/shortid": "0.0.32",
    "@types/uuid": "10.0.0",
    "bcryptjs": "2.4.3",
    "chalk": "5.6.2",
    "chalk-template": "1.1.3",
    "connect-redis": "6.1.3",
    "cookie-parser": "^1.4.7",
    "copyfiles": "2.4.1",
    "crypto-js": "4.2.0",
    "date-fns": "4.4.0",
    "dotenv": "16.6.1",
    "express": "4.22.1",
    "express-mung": "0.5.1",
    "express-rate-limit": "6.11.2",
    "express-session": "1.19.0",
    "freemail": "1.7.0",
    "handlebars": "4.7.10",
    "jest": "29.7.0",
    "lexorank": "1.0.5",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "moment": "2.31.0",
    "node-fetch": "3.3.2",
    "nodemailer": "6.10.1",
    "nodemon": "3.1.14",
    "openai": "4.104.0",
    "passport": "0.5.0",
    "passport-github2": "0.1.12",
    "passport-google-oauth20": "2.0.0",
    "passport-local": "1.0.0",
    "passport-microsoft": "1.0.0",
    "passport-okta-oauth20": "1.1.0",
    "passport-slack-oauth2": "1.2.0",
    "passport-twitter": "^1.0.4",
    "pg": "8.23.1",
    "rate-limiter-flexible": "2.4.1",
    "redis": "3.1.2",
    "rimraf": "6.1.4",
    "scripty": "^2.1.1",
    "shortid": "2.2.17",
    "socket.io": "4.8.4",
    "stripe": "17.7.0",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typeorm": "0.3.30",
    "typeorm-naming-strategies": "4.1.0",
    "typescript": "5.9.3",
    "unique-names-generator": "^4.7.1",
    "uuid": "10.0.0"
  },
  "resolutions": {
    "@types/connect-redis": "0.0.19",
    "@types/express-session": "1.17.3"
  },
  "nodemonConfig": {
    "watch": "./src/",
    "ext": "ts,tsx,json"
  }
}
