---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LegacyLegalPage from '../../../../src/pages/legal/[slug]';
import LegacyPageIsland from '../../../compat/legacy-page-island';
import markdownToHtml from '../../../../src/lib/mdToHtml';
import { getAllLegalDocuments, getLegalByName } from '../../../../src/lib/getLegal';
import { renderLegacyPage } from '../../../compat/legacy-render';
import { loadDictionaryWithFallback } from '../../../lib/dictionary';
import { getNonDefaultLocales, type SupportedLocale } from '../../../lib/locales';

export function getStaticPaths() {
  return getNonDefaultLocales().flatMap((locale) =>
    getAllLegalDocuments().map((entry) => ({
      params: { locale, slug: entry.slug },
    })),
  );
}

const locale = Astro.params.locale as SupportedLocale;
const dictionary = loadDictionaryWithFallback(locale);
const { slug } = Astro.params;

if (!slug) {
  throw new Error('Missing legal slug');
}

const legals = getAllLegalDocuments();
const sourceDocument = getLegalByName(slug);
const document = {
  ...sourceDocument,
  content: await markdownToHtml(sourceDocument.content || ''),
};
const rendered = renderLegacyPage({
  component: LegacyLegalPage,
  props: { document, legals },
  locale,
  asPath: `/${locale}/legal/${slug}`,
  pathname: `/legal/${slug}`,
});
---

<BaseLayout
  locale={locale}
  pathname={`/legal/${document.slug}`}
  title={`${document.title} | Retrospected`}
  description={document.title}
  headStyles={rendered.styles}
>
  <LegacyPageIsland
    page="legal"
    pageProps={{ document, legals }}
    locale={locale}
    dictionary={dictionary}
    asPath={`/${locale}/legal/${slug}`}
    pathname={`/legal/${slug}`}
    client:load
  />
</BaseLayout>